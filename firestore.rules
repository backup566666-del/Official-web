rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'michalmark496@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'avatarUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 120))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'description', 'startsAt', 'published', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'startsAt', 'location', 'published', 'createdBy', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 140
        && data.description is string
        && data.description.size() >= 5
        && data.description.size() <= 2000
        && data.startsAt is string
        && data.startsAt.size() >= 4
        && data.startsAt.size() <= 64
        && (!('location' in data) || (data.location is string && data.location.size() <= 160))
        && data.published is bool
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['userId', 'characterName', 'discordHandle', 'backstory', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'characterName', 'discordHandle', 'backstory', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.characterName is string
        && data.characterName.size() >= 2
        && data.characterName.size() <= 80
        && data.discordHandle is string
        && data.discordHandle.size() >= 2
        && data.discordHandle.size() <= 80
        && data.backstory is string
        && data.backstory.size() >= 20
        && data.backstory.size() <= 2000
        && data.status is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Member private profiles (PII isolated to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'avatarUrl', 'updatedAt']);
      allow delete: if false;
    }

    // Linked Discord summary: readable by owning member or admin; written server-side only
    match /discordConnections/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Server-only Discord OAuth states and tokens: completely inaccessible to client SDKs
    match /discordOAuthStates/{stateHash} {
      allow read, write: if false;
    }

    match /discordOAuthTokens/{userId} {
      allow read, write: if false;
    }

    // Community events: public read for published events only, admin-only writes
    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isValidId(eventId)
        && isAdmin()
        && isValidEvent(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(eventId)
        && isAdmin()
        && isValidEvent(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'startsAt', 'location', 'published', 'updatedAt']);
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // Member applications: owner-scoped create/read/pending-edit, admin review
    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(applicationId)
        && isVerifiedUser()
        && isValidApplication(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(applicationId)
        && isVerifiedUser()
        && isValidApplication(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          (existing().userId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['characterName', 'discordHandle', 'backstory', 'updatedAt']))
        );
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // Admin lookup documents: locked against client writes
    match /admins/{userId} {
      allow get: if isValidId(userId) && isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
