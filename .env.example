# Firebase Authentication (GoogleAuthProvider) and Cloud Firestore use the public
# web configuration in firebase-applet-config.json (project noble-leaf-h6gf7).
# No frontend Supabase, Lovable, or Google OAuth client-secret variables are required.

# Server-side Discord OAuth & Official Server Check (keep strictly server-side; NEVER prefix with VITE_)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Server-side Free City Railway Bot API Connection (keep strictly server-side; NEVER expose in browser code)
# Proposed contract: GET /health and GET /api/members/:discordUserId with header x-api-key
FREE_CITY_BOT_API_URL=
FREE_CITY_BOT_API_KEY=

# Optional: Firebase Service Account JSON (minified) for server-side Admin Firestore access when running outside GCP Cloud Run ADC
FIREBASE_SERVICE_ACCOUNT_JSON=